# Copie este arquivo para ".env" e ajuste os valores.
# NUNCA envie o arquivo ".env" (com senhas reais) para o Git.

# String de conexão com o PostgreSQL.
# Se estiver usando o docker-compose.yml deste projeto, o valor abaixo já funciona.
DATABASE_URL=postgresql+psycopg://padaria:padaria@localhost:5432/padaria

# Chave usada para assinar o cookie de sessão (login). Gere uma string aleatória.
# Exemplo de como gerar uma: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-por-uma-aleatoria
